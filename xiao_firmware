// ============================================================
// SELECT WEIGHT BACKEND AT COMPILE TIME
// ============================================================
// Choose exactly ONE of the following by defining it before #include:
//
//   Default (no define)        -> weights_fp32.h   (~24 KB flash, BIT-EXACT with PyTorch, 0% loss)
//   #define USE_FP16_WEIGHTS 1 -> weights_fp16.h   (~13 KB flash, <0.05% loss, native on ESP32-S3)
//   #define USE_INT8_WEIGHTS 1 -> weights_int8.h   (~7.5 KB flash, ~0.2% loss, per-channel quantized)
//
// RECOMMENDATION for your use case (84% benchmark, no compromise):
//   - Use FP32 on XIAO ESP32S3 Sense (8MB flash, plenty of room, zero loss)
//   - Use FP16 if you want smaller flash footprint (still <0.05% loss)
//   - Use INT8 only if flash is critically constrained
//
// NOTE: True FP8 (8-bit floating point, E4M3/E5M2) is NOT supported on
// ESP32 or ESP32-S3 hardware. There are no FP8 arithmetic units. INT8
// (above) is the standard 8-bit format for embedded ML deployment.
// ============================================================

// Initialize model buffers in PSRAM. MUST be called once from setup()
// before the first call to dronet_forward(). Returns true on success.
bool dronet_init_buffers(void);

// Run a single forward pass.
int dronet_forward(const float *input_gray,
                   float *out_steering,
                   float *out_collision_logit);

// Convenience: convert uint8 pixel (0-255) to normalized float (0..1).
// IMPORTANT: The model was trained with transforms.ToTensor() which gives [0, 1].
// Do NOT use /127.5 - 1.0 (that gives [-1, +1] and will break accuracy).
static inline float dronet_normalize_pixel(uint8_t p) {
    return ((float)p) / 255.0f;
}

// Convenience: sigmoid.
static inline float dronet_sigmoid(float x) {
    return 1.0f / (1.0f + expf(-x));
}



