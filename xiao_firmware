// ============================================================
// SECTION 4: Forward pass implementation
// ============================================================
// ============================================================
// dronet_model_fp32.c — fp32 forward pass for GoldenEliteDronetV3
// Mirrors the PyTorch model EXACTLY (same layer order, strides, paddings).
// ============================================================


#include <string.h>
#include <math.h>

// ============================================================
// BUFFERS — dynamically allocated in PSRAM at init time
// ============================================================
// The ESP32 has only ~320 KB of internal DRAM, but our buffers total
// ~800 KB. We MUST use PSRAM (4 MB external).
//
// In Arduino-ESP32 v3.x, EXT_RAM_BSS_ATTR doesn't reliably place static
// buffers in PSRAM. Instead, we use ps_malloc() (or heap_caps_malloc with
// MALLOC_CAP_SPIRAM) to dynamically allocate in PSRAM at runtime.
//
// These pointers are initialized by dronet_init_buffers() which must be
// called once from setup() before the first inference.
static float *buf_input = NULL;    // INPUT_PIXELS = 40,000 floats = 160 KB
static float *buf_stem_dw = NULL;  // 1 * 100 * 100 = 10,000 floats = 40 KB
static float *buf_stem_pw = NULL;  // 8 * 100 * 100 = 80,000 floats = 320 KB
static float *buf_pool = NULL;     // 8 * 50 * 50 = 20,000 floats = 80 KB
static float *buf_blk1 = NULL;     // 8 * 25 * 25 = 5,000 floats = 20 KB
static float *buf_blk2 = NULL;     // 16 * 13 * 13 = 2,704 floats = 10.8 KB
static float *buf_blk3 = NULL;     // 32 * 7 * 7 = 1,568 floats = 6.3 KB

// Allocate all buffers in PSRAM. Call this once from setup().
// Returns true on success, false if PSRAM is not available or allocation failed.
bool dronet_init_buffers(void) {
    // Check if PSRAM is available
    if (ESP.getPsramSize() == 0) {
        return false;
    }

    buf_input  = (float*) ps_malloc(INPUT_PIXELS * sizeof(float));
    buf_stem_dw = (float*) ps_malloc(1 * 100 * 100 * sizeof(float));
    buf_stem_pw = (float*) ps_malloc(8 * 100 * 100 * sizeof(float));
    buf_pool    = (float*) ps_malloc(8 * 50 * 50 * sizeof(float));
    buf_blk1    = (float*) ps_malloc(8 * 25 * 25 * sizeof(float));
    buf_blk2    = (float*) ps_malloc(16 * 13 * 13 * sizeof(float));
    buf_blk3    = (float*) ps_malloc(32 * 7 * 7 * sizeof(float));

    if (!buf_input || !buf_stem_dw || !buf_stem_pw || !buf_pool ||
        !buf_blk1 || !buf_blk2 || !buf_blk3) {
        return false;  // allocation failed
    }
    return true;
}

// ----- conv2d (standard / pointwise) -----
static void conv2d_fp32(const float *input,
                        int in_ch, int in_h, int in_w,
                        const float *weight,
                        const float *bias,
                        int out_ch, int kh, int kw,
                        int stride, int pad, int groups,
                        float *output)
{
    int out_h = (in_h + 2*pad - kh) / stride + 1;
    int out_w = (in_w + 2*pad - kw) / stride + 1;
    if (groups == out_ch && out_ch > 1) {
        for (int c = 0; c < out_ch; c++) {
            const float *w_c = weight + c * kh * kw;
            float b = bias[c];
            for (int oh = 0; oh < out_h; oh++) {
                for (int ow = 0; ow < out_w; ow++) {
                    float acc = b;
                    for (int ky = 0; ky < kh; ky++) {
                        int ih = oh * stride + ky - pad;
                        if (ih < 0 || ih >= in_h) continue;
                        for (int kx = 0; kx < kw; kx++) {
                            int iw = ow * stride + kx - pad;
                            if (iw < 0 || iw >= in_w) continue;
                            float pix = input[c * in_h * in_w + ih * in_w + iw];
                            acc += pix * w_c[ky * kw + kx];
                        }
                    }
                    output[c * out_h * out_w + oh * out_w + ow] = acc;
                }
            }
        }
    } else {
        for (int oc = 0; oc < out_ch; oc++) {
            float b = bias[oc];
            for (int oh = 0; oh < out_h; oh++) {
                for (int ow = 0; ow < out_w; ow++) {
                    float acc = b;
                    for (int ic = 0; ic < in_ch; ic++) {
                        const float *w_oc_ic = weight + (oc * in_ch + ic) * kh * kw;
                        const float *in_ic = input + ic * in_h * in_w;
                        for (int ky = 0; ky < kh; ky++) {
                            int ih = oh * stride + ky - pad;
                            if (ih < 0 || ih >= in_h) continue;
                            for (int kx = 0; kx < kw; kx++) {
                                int iw = ow * stride + kx - pad;
                                if (iw < 0 || iw >= in_w) continue;
                                acc += in_ic[ih * in_w + iw] * w_oc_ic[ky * kw + kx];
                            }
                        }
                    }
                    output[oc * out_h * out_w + oh * out_w + ow] = acc;
                }
            }
        }
    }
}

static void relu6_inplace(float *x, int n) {
    for (int i = 0; i < n; i++) {
        if (x[i] < 0.0f) x[i] = 0.0f;
        else if (x[i] > 6.0f) x[i] = 6.0f;
    }
}

static void maxpool2x2_fp32(const float *input, int ch, int h, int w,
                            float *output) {
    int out_h = h / 2;
    int out_w = w / 2;
    for (int c = 0; c < ch; c++) {
        for (int oh = 0; oh < out_h; oh++) {
            for (int ow = 0; ow < out_w; ow++) {
                int ih = oh * 2, iw = ow * 2;
                float a = input[c*h*w + ih*w     + iw];
                float b = input[c*h*w + ih*w     + iw+1];
                float c2= input[c*h*w + (ih+1)*w + iw];
                float d = input[c*h*w + (ih+1)*w + iw+1];
                float m = a;
                if (b > m) m = b;
                if (c2> m) m = c2;
                if (d > m) m = d;
                output[c*out_h*out_w + oh*out_w + ow] = m;
            }
        }
    }
}

static void linear_fp32(const float *input, int in_features,
                        const float *weight, const float *bias,
                        int out_features, float *output) {
    for (int o = 0; o < out_features; o++) {
        float acc = bias ? bias[o] : 0.0f;
        const float *w_row = weight + o * in_features;
        for (int i = 0; i < in_features; i++) {
            acc += input[i] * w_row[i];
        }
        output[o] = acc;
    }
}

int dronet_forward(const float *input_gray,
                   float *out_steering,
                   float *out_collision_logit)
{
    // Safety check — buffers must be initialized
    if (!buf_input || !buf_stem_pw) {
        *out_steering = 0.0f;
        *out_collision_logit = 0.0f;
        return -1;
    }

    memcpy(buf_input, input_gray, INPUT_PIXELS * sizeof(float));

    conv2d_fp32(buf_input, 1, 200, 200,
                w_stem_dw, b_stem_dw, 1, 3, 3, 2, 1, 1, buf_stem_dw);
    conv2d_fp32(buf_stem_dw, 1, 100, 100,
                w_stem_pw, b_stem_pw, 8, 1, 1, 1, 0, 1, buf_stem_pw);
    relu6_inplace(buf_stem_pw, 8*100*100);
    maxpool2x2_fp32(buf_stem_pw, 8, 100, 100, buf_pool);

    conv2d_fp32(buf_pool,  8, 50, 50, w_Block1_depthconv1, b_Block1_depthconv1, 8, 3, 3, 2, 1, 8, buf_blk1);
    relu6_inplace(buf_blk1, 8*25*25);
    conv2d_fp32(buf_blk1,  8, 25, 25, w_Block1_pointwise1, b_Block1_pointwise1, 8, 1, 1, 1, 0, 1, buf_pool);
    relu6_inplace(buf_pool, 8*25*25);
    conv2d_fp32(buf_pool,  8, 25, 25, w_Block1_depthconv2, b_Block1_depthconv2, 8, 3, 3, 1, 1, 8, buf_blk1);
    relu6_inplace(buf_blk1, 8*25*25);
    conv2d_fp32(buf_blk1,  8, 25, 25, w_Block1_pointwise2, b_Block1_pointwise2, 8, 1, 1, 1, 0, 1, buf_pool);
    relu6_inplace(buf_pool, 8*25*25);

    conv2d_fp32(buf_pool,  8,  25, 25, w_Block2_depthconv1, b_Block2_depthconv1, 8,  3, 3, 2, 1, 8,  buf_blk2);
    relu6_inplace(buf_blk2, 8*13*13);
    conv2d_fp32(buf_blk2,  8,  13, 13, w_Block2_pointwise1, b_Block2_pointwise1, 16, 1, 1, 1, 0, 1,  buf_pool);
    relu6_inplace(buf_pool, 16*13*13);
    conv2d_fp32(buf_pool,  16, 13, 13, w_Block2_depthconv2, b_Block2_depthconv2, 16, 3, 3, 1, 1, 16, buf_blk2);
    relu6_inplace(buf_blk2, 16*13*13);
    conv2d_fp32(buf_blk2,  16, 13, 13, w_Block2_pointwise2, b_Block2_pointwise2, 16, 1, 1, 1, 0, 1,  buf_pool);
    relu6_inplace(buf_pool, 16*13*13);

    conv2d_fp32(buf_pool,  16, 13, 13, w_Block3_depthconv1, b_Block3_depthconv1, 16, 3, 3, 2, 1, 16, buf_blk3);
    relu6_inplace(buf_blk3, 16*7*7);
    conv2d_fp32(buf_blk3,  16, 7, 7,  w_Block3_pointwise1, b_Block3_pointwise1, 32, 1, 1, 1, 0, 1,  buf_pool);
    relu6_inplace(buf_pool, 32*7*7);
    conv2d_fp32(buf_pool,  32, 7, 7,  w_Block3_depthconv2, b_Block3_depthconv2, 32, 3, 3, 1, 1, 32, buf_blk3);
    relu6_inplace(buf_blk3, 32*7*7);
    conv2d_fp32(buf_blk3,  32, 7, 7,  w_Block3_pointwise2, b_Block3_pointwise2, 32, 1, 1, 1, 0, 1,  buf_pool);
    relu6_inplace(buf_pool, 32*7*7);

    float out[2];
    linear_fp32(buf_pool, 1568, w_fc, b_fc, 2, out);

    *out_steering         = out[0];
    *out_collision_logit  = out[1];
    return 0;
}


// ============================================================
// SECTION 5: XIAO ESP32S3 Sense firmware
// (camera capture + UART protocol + main loop)
// ============================================================
// ============================================================
// esp32_cam_main_xiao.c
// ---------------------
// XIAO ESP32S3 Sense firmware with IDLE/START-STOP protocol.
//
// PROTOCOL:
//   - On boot: camera is ON, but inference is OFF (idle state)
//   - LiteWing sends commands via UART:
//       0x53 ('S') = START inference (begin sending vision packets)
//       0x58 ('X') = STOP inference (stop sending packets, go idle)
//   - When START received: runs inference loop, sends 8-byte packets
//   - When STOP received: stops inference, sends nothing
//   - Default state: IDLE
//
// This saves power and reduces UART traffic when not in autonomous mode.
//
// HARDWARE:
//   - Seeed Studio XIAO ESP32S3 Sense (with camera expansion)
//   - OV2640/OV3660 camera
//   - UART1: TX=GPIO43 (D6), RX=GPIO44 (D7) for LiteWing communication
//   - USB-CDC (Serial) for debugging via USB-C
//
// WIRING (XIAO <-> LiteWing):
//   XIAO BAT+ (back pad)  -> LiteWing +BATT (main battery pad)
//   XIAO BAT- (back pad)  -> LiteWing GND  (main battery pad)
//   XIAO D6 / GPIO43 (TX) -> LiteWing IO1  (UART1 RX)
//   XIAO D7 / GPIO44 (RX) -> LiteWing IO48 (UART1 TX)
//
// POWER:
//   The XIAO is powered directly from the LiteWing's 3.7V LiPo battery
//   via the BAT+ pad. The XIAO has a built-in battery charger and power
//   management IC — no boost converter needed!
//
// BUILD (Arduino IDE):
//   - Board: "XIAO ESP32S3"
//   - USB CDC On Boot: Enabled
//   - PSRAM: Enabled (OPI PSRAM 8MB)
//   - Upload Mode: UART0 / Hardware CDC
//   - Flash Size: 8MB
// ============================================================

// dronet_model.h inlined above
#include "esp_camera.h"
#include <HardwareSerial.h>
#include <strings.h>

// ============================================================
// CAMERA PIN DEFINITIONS — XIAO ESP32S3 Sense
// ============================================================
#define PWDN_GPIO_NUM     -1   // Hardwired on Sense expansion
#define RESET_GPIO_NUM    -1   // Hardwired on Sense expansion
#define XCLK_GPIO_NUM     10
#define SIOD_GPIO_NUM     40   // I2C data (SDA)
#define SIOC_GPIO_NUM     39   // I2C clock (SCL)
#define Y9_GPIO_NUM       48
#define Y8_GPIO_NUM       11
#define Y7_GPIO_NUM       12
#define Y6_GPIO_NUM       14
#define Y5_GPIO_NUM       16
#define Y4_GPIO_NUM       18
#define Y3_GPIO_NUM       17
#define Y2_GPIO_NUM       15
#define VSYNC_GPIO_NUM    38
#define HREF_GPIO_NUM     47
#define PCLK_GPIO_NUM     13

// ============================================================
// UART TO LITEWING
// Use Serial1 on GPIO44 (RX) / GPIO43 (TX) = D7/D6 on XIAO breakout.
// USB-CDC (Serial) is used for debugging via USB-C.
// ============================================================
#define UART_TO_LITEWING   Serial1
#define UART_TX_PIN        43   // D6 on XIAO
#define UART_RX_PIN        44   // D7 on XIAO
#define UART_BAUD          115200

// ============================================================
// COMMAND PROTOCOL (from LiteWing)
// ============================================================
#define CMD_START          0x53   // 'S' = start inference
#define CMD_STOP           0x58   // 'X' = stop inference

// ============================================================
// PACKET FORMAT (to LiteWing)
// 8 bytes: [0xAA][0x55][steer_h][steer_l][coll_h][coll_l][flags][checksum]
// ============================================================
#define PKT_HEADER_0     0xAA
#define PKT_HEADER_1     0x55
#define PKT_LEN          8

// ============================================================
// STATE
// ============================================================
static bool inference_running = true;  // false = idle, true = running
static float *input_gray = NULL;        // allocated in PSRAM
static char command_buffer[8];
static size_t command_buffer_len = 0;

camera_config_t config;

bool init_camera() {
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;
    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;
    config.pin_xclk = XCLK_GPIO_NUM;
    config.pin_pclk = PCLK_GPIO_NUM;
    config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM;
    config.pin_sscb_sda = SIOD_GPIO_NUM;
    config.pin_sscb_scl = SIOC_GPIO_NUM;
    config.pin_pwdn = PWDN_GPIO_NUM;
    config.pin_reset = RESET_GPIO_NUM;
    config.xclk_freq_hz = 20000000;
    config.pixel_format = PIXFORMAT_GRAYSCALE;
    config.frame_size = FRAMESIZE_QVGA;  // 320x240, crop to 200x200
    config.jpeg_quality = 12;
    config.fb_count = 1;
    config.fb_location = CAMERA_FB_IN_PSRAM;
    config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;

    esp_err_t err = esp_camera_init(&config);
    if (err != ESP_OK) {
        Serial.printf("Camera init failed: 0x%x\n", err);
        return false;
    }
    return true;
}

bool grab_and_preprocess() {
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) return false;
    int src_w = fb->width;
    int src_h = fb->height;
    if (src_w < 200 || src_h < 200) {
        esp_camera_fb_return(fb);
        return false;
    }
    int crop_x = (src_w - 200) / 2;
    int crop_y = (src_h - 200) / 2;
    for (int y = 0; y < 200; y++) {
        const uint8_t *src_row = fb->buf + (crop_y + y) * src_w + crop_x;
        for (int x = 0; x < 200; x++) {
            input_gray[y * 200 + x] = dronet_normalize_pixel(src_row[x]);
        }
    }
    esp_camera_fb_return(fb);
    return true;
}

void send_to_litewing(float steering_norm, float collision_prob, bool model_valid) {
    uint8_t pkt[PKT_LEN];
    pkt[0] = PKT_HEADER_0;
    pkt[1] = PKT_HEADER_1;
    float s = steering_norm;
    if (s > 1.0f) s = 1.0f;
    if (s < -1.0f) s = -1.0f;
    int16_t steer_i = (int16_t)(s * 32767.0f);
    uint16_t coll_i = (uint16_t)(collision_prob * 65535.0f);
    uint8_t flags = 0;
    if (collision_prob > 0.5f) flags |= 0x01;
    if (model_valid)           flags |= 0x02;
    pkt[2] = (uint8_t)((steer_i >> 8) & 0xFF);
    pkt[3] = (uint8_t)( steer_i       & 0xFF);
    pkt[4] = (uint8_t)((coll_i  >> 8) & 0xFF);
    pkt[5] = (uint8_t)( coll_i        & 0xFF);
    pkt[6] = flags;
    pkt[7] = pkt[2] ^ pkt[3] ^ pkt[4] ^ pkt[5] ^ pkt[6];
    UART_TO_LITEWING.write(pkt, PKT_LEN);
    Serial.printf("[UART TX] packet: %02X %02X %02X %02X %02X %02X %02X %02X flags=0x%02X valid=%d\n",
                  pkt[0], pkt[1], pkt[2], pkt[3], pkt[4], pkt[5], pkt[6], pkt[7], flags, model_valid ? 1 : 0);
}

static void process_camera_command(uint8_t cmd) {
    if (cmd == CMD_START || cmd == 'S' || cmd == 's') {
        Serial.printf("[UART RX] cmd=0x%02X ('%c') -> START\n", cmd, cmd);
        if (!inference_running) {
            inference_running = true;
            Serial.println("[CMD] START received — inference ON");
        }
        command_buffer_len = 0;
        return;
    }
    if (cmd == CMD_STOP || cmd == 'X' || cmd == 'x') {
        Serial.printf("[UART RX] cmd=0x%02X ('%c') -> STOP\n", cmd, cmd);
        if (inference_running) {
            inference_running = false;
            Serial.println("[CMD] STOP received — inference OFF (idle)");
        }
        command_buffer_len = 0;
        return;
    }
    if (cmd == '\r' || cmd == '\n' || cmd == ' ' || cmd == '\t') {
        return;
    }
    Serial.printf("[UART RX] byte=0x%02X ('%c') buffering\n", cmd, cmd);
    if (command_buffer_len < sizeof(command_buffer) - 1) {
        command_buffer[command_buffer_len++] = (char)cmd;
        command_buffer[command_buffer_len] = '\0';
    } else {
        Serial.println("[UART RX] command buffer overflow, resetting");
        command_buffer_len = 0;
    }
    if (command_buffer_len >= 5) {
        if (strcasecmp(command_buffer, "START") == 0) {
            Serial.println("[UART RX] START string detected");
            if (!inference_running) {
                inference_running = true;
                Serial.println("[CMD] START received — inference ON");
            }
            command_buffer_len = 0;
            return;
        }
        if (strcasecmp(command_buffer, "STOP") == 0) {
            Serial.println("[UART RX] STOP string detected");
            if (inference_running) {
                inference_running = false;
                Serial.println("[CMD] STOP received — inference OFF (idle)");
            }
            command_buffer_len = 0;
            return;
        }
        Serial.printf("[UART RX] unknown command buffer '%s'\n", command_buffer);
        command_buffer_len = 0;
    }
}

void check_commands() {
    while (UART_TO_LITEWING.available()) {
        int c = UART_TO_LITEWING.read();
        if (c < 0) {
            break;
        }
        process_camera_command((uint8_t)c);
    }
    while (Serial.available()) {
        int c = Serial.read();
        if (c < 0) {
            break;
        }
        process_camera_command((uint8_t)c);
    }
}

void setup() {
    // USB-CDC for debugging
    Serial.begin(115200);
    delay(2000);
    Serial.println("\n=== XIAO ESP32S3 Sense — Drone Vision Module ===");
    Serial.println("Protocol: IDLE by default, START/STOP commands from LiteWing");

    // UART1 to LiteWing on D6 (TX=43) / D7 (RX=44)
    UART_TO_LITEWING.begin(UART_BAUD, SERIAL_8N1, UART_RX_PIN, UART_TX_PIN);
    Serial.printf("UART1 to LiteWing: TX=GPIO%d (D6) RX=GPIO%d (D7) @ %d baud\n",
                  UART_TX_PIN, UART_RX_PIN, UART_BAUD);

    // Init camera
    if (!init_camera()) {
        Serial.println("HALT: camera init failed!");
        while (1) { delay(1000); }
    }
    Serial.println("Camera initialized: QVGA 320x240 grayscale -> crop to 200x200");
    Serial.flush();

    // Check PSRAM
    Serial.println("Checking PSRAM...");
    Serial.flush();
    if (ESP.getPsramSize() == 0) {
        Serial.println("HALT: PSRAM not enabled! Set Tools > PSRAM > Enabled");
        Serial.flush();
        while (1) { delay(1000); }
    }
    Serial.printf("PSRAM: %u bytes free (%u total)\n",
                  ESP.getFreePsram(), ESP.getPsramSize());
    Serial.flush();

    // Allocate model buffers in PSRAM
    Serial.println("Allocating model buffers in PSRAM...");
    Serial.flush();
    if (!dronet_init_buffers()) {
        Serial.println("HALT: Failed to allocate model buffers!");
        while (1) { delay(1000); }
    }
    input_gray = (float*) ps_malloc(INPUT_PIXELS * sizeof(float));
    if (!input_gray) {
        Serial.println("HALT: Failed to allocate input buffer!");
        while (1) { delay(1000); }
    }
    Serial.printf("Model buffers allocated. PSRAM remaining: %u bytes\n",
                  ESP.getFreePsram());

    Serial.println("\nState: RUNNING (Inference starts automatically)");
    Serial.println("Send 'X' (0x58) to stop.\n");
}

void loop() {
    // Always check for commands (even when idle)
    check_commands();

    if (!inference_running) {
        // IDLE state — no inference, no packets
        // Just wait for commands
        delay(50);
        return;
    }

    // RUNNING state — capture, infer, send packet
    uint32_t t_start = millis();

    if (!grab_and_preprocess()) {
        delay(50);
        return;
    }

    float steering, collision_logit;
    int ret = dronet_forward(input_gray, &steering, &collision_logit);
    bool model_valid = (ret == 0);
    float collision_prob = dronet_sigmoid(collision_logit);
    float yaw_deg = steering * 90.0f;

    uint32_t t_end = millis();
    float fps = 1000.0f / (t_end - t_start);

    // Debug output to USB-CDC
    Serial.printf("[%.1f FPS] yaw=%+6.2f deg  coll_prob=%.3f  %s\n",
                  fps, yaw_deg, collision_prob,
                  collision_prob > 0.5 ? "COLLISION!" : "clear");

    // Send vision packet to LiteWing
    send_to_litewing(steering, collision_prob, model_valid);

    // Check for commands (non-blocking)
    check_commands();

    // Pace the loop (~10 FPS target)
    uint32_t elapsed = millis() - t_start;
    if (elapsed < 100) {
        delay(100 - elapsed);
    }
}

